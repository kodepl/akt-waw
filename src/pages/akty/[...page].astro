---
import Kronika from "../../layouts/Kronika.astro";
import { getCollection } from "astro:content";
import { coverFor } from "../../site.config";

export async function getStaticPaths({ paginate }: { paginate: any }) {
  const posts = (await getCollection("akty")).sort(
    (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
  );
  return paginate(posts, { pageSize: 9 });
}

const { page } = Astro.props;
---
<Kronika title="Akty" description="Archiwum Aktu Warszawskiego">
  <main class="mx-auto max-w-3xl px-4 py-10">
    <h1 class="font-display text-4xl font-bold">Akty</h1>
    <ul class="mt-10 space-y-8">
      {page.data.map((post, i) => (
        <li class="flex gap-4 border-b border-line pb-6">
          <span class="font-mono text-stamp">{String((page.currentPage - 1) * page.size + i + 1).padStart(2, "0")}</span>
          <div>
            <p class="font-mono text-[10px] uppercase text-slate">{post.data.dzielnica}</p>
            <a href={`/akty/${post.slug}/`} class="font-display text-2xl font-semibold hover:text-stamp">{post.data.title}</a>
          </div>
          <img src={coverFor(post.data.dzielnica, post.data.image)} alt="" class="ml-auto hidden h-14 w-20 border border-line object-cover sm:block" />
        </li>
      ))}
    </ul>
  </main>

  {page.lastPage > 1 && (
    <nav class="mt-12 flex flex-wrap items-center justify-center gap-3 text-sm" aria-label="Paginacja">
      {page.url.prev ? (
        <a href={page.url.prev} class="underline-offset-2 hover:underline">← Nowsze</a>
      ) : (
        <span class="opacity-40">← Nowsze</span>
      )}
      <span class="tabular-nums opacity-70">{page.currentPage} / {page.lastPage}</span>
      {page.url.next ? (
        <a href={page.url.next} class="underline-offset-2 hover:underline">Starsze →</a>
      ) : (
        <span class="opacity-40">Starsze →</span>
      )}
    </nav>
  )}

</Kronika>
