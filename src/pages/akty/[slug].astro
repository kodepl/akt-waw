---
import Kronika from "../../layouts/Kronika.astro";
import { getCollection } from "astro:content";
import site, { coverFor } from "../../site.config";
export async function getStaticPaths() {
  const posts = await getCollection("akty");
  return posts.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}
const { post } = Astro.props;
const { Content } = await post.render();
const cover = coverFor(post.data.dzielnica, post.data.image);
const date = post.data.pubDate.toLocaleDateString("pl-PL", { day: "numeric", month: "long", year: "numeric" });
---
<Kronika title={post.data.title} description={post.data.description} image={cover}>
  <article class="mx-auto max-w-3xl px-4 py-10">
    <p class="font-mono text-[10px] uppercase tracking-[0.25em] text-stamp">{post.data.dzielnica} · {post.data.numer} · {date}</p>
    <h1 class="mt-3 font-display text-4xl font-bold leading-tight">{post.data.title}</h1>
    <p class="mt-4 text-lg text-slate">{post.data.description}</p>
    <div class="mt-5 flex items-center gap-3 text-sm">
      <img src={site.authorAvatar} alt="" class="h-10 w-10 rounded-full border-2 border-navy object-cover" />
      <div>
        <p class="font-semibold">{post.data.author || site.author}</p>
        <p class="text-xs text-slate">{post.data.authorBio || site.authorBio}</p>
      </div>
    </div>
    <img src={cover} alt="" class="mt-8 aspect-[16/10] w-full border-2 border-navy object-cover" />
    <div class="prose prose-slate prose-headings:font-display prose-a:text-stamp mt-10 max-w-none">
      <Content />
    </div>
  </article>
</Kronika>
