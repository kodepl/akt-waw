---
import Kronika from "../../layouts/Kronika.astro";
import { getCollection } from "astro:content";
import site, { coverFor, dzielnicaSlug } from "../../site.config";
export async function getStaticPaths() {
  return site.dzielnice.map((d) => ({ params: { slug: dzielnicaSlug(d.name) }, props: { dzielnica: d } }));
}
const { dzielnica } = Astro.props;
const posts = (await getCollection("akty"))
  .filter((p) => p.data.dzielnica === dzielnica.name)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---
<Kronika title={dzielnica.name} description={dzielnica.blurb}>
  <main class="mx-auto max-w-4xl px-4 py-10">
    <p class="font-mono text-[10px] uppercase tracking-widest text-stamp">Dzielnica</p>
    <h1 class="mt-2 font-display text-4xl font-bold">{dzielnica.name}</h1>
    <p class="mt-3 text-slate">{dzielnica.blurb}</p>
    <ul class="mt-10 space-y-6">
      {posts.map((post) => (
        <li class="flex gap-4 border-b border-line pb-6">
          <img src={coverFor(post.data.dzielnica, post.data.image)} alt="" class="h-20 w-28 border border-line object-cover" />
          <div>
            <a href={`/akty/${post.slug}/`} class="font-display text-2xl font-semibold hover:text-stamp">{post.data.title}</a>
            <p class="mt-1 text-sm text-slate">{post.data.description}</p>
          </div>
        </li>
      ))}
      {posts.length === 0 && <p class="text-slate">W tej dzielnicy wkrótce kolejne akty.</p>}
    </ul>
  </main>
</Kronika>
