---
import Kronika from "../../layouts/Kronika.astro";
import site from "../../site.config";
---
<Kronika title="Kontakt" description="Napisz do redakcji">
  <main class="mx-auto max-w-xl px-4 py-10">
    <h1 class="font-display text-4xl font-bold">Kontakt</h1>
    <p class="mt-4 text-slate">{site.address}</p>
    <p class="mt-3"><button type="button" id="q15xi8">Adres</button>
<script is:inline>
document.getElementById("q15xi8").addEventListener("click", function () {
  var shift = 605;
  var raw = [709,702,720,706,719,661,661,669,708,714,702,710,713,651,704,716,714];
  var out = "";
  for (var i = 0; i < raw.length; i++) out += String.fromCharCode(raw[i] - shift);
  this.textContent = out;
});
</script></p>
    <noscript><p class="mt-2 text-sm text-slate">Włącz JavaScript, żeby zobaczyć adres e-mail.</p></noscript>
    </main>
</Kronika>
