---
import Kronika from "../layouts/Kronika.astro";
import { getCollection } from "astro:content";
import site, { coverFor, dzielnicaSlug } from "../site.config";
const posts = (await getCollection("akty")).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const lead = posts[0];
const rest = posts.slice(1);
---
<Kronika title={site.name} description={site.tagline} image={site.heroImage}>
  <main class="mx-auto max-w-5xl px-4 py-10">
    {lead && (
      <section class="grid gap-8 border-b-2 border-navy pb-12 lg:grid-cols-12">
        <div class="lg:col-span-7">
          <p class="font-mono text-[10px] uppercase tracking-[0.25em] text-stamp">Akt dnia · {lead.data.numer || lead.data.dzielnica}</p>
          <h1 class="mt-3 font-display text-4xl font-bold leading-tight md:text-5xl">
            <a href={`/akty/${lead.slug}/`} class="hover:text-stamp">{lead.data.title}</a>
          </h1>
          <p class="mt-4 text-lg text-slate">{lead.data.description}</p>
          <a href={`/akty/${lead.slug}/`} class="mt-6 inline-block border-2 border-navy px-4 py-2 font-mono text-xs uppercase tracking-widest hover:bg-navy hover:text-paper">Czytaj akt →</a>
        </div>
        <a href={`/akty/${lead.slug}/`} class="lg:col-span-5">
          <img src={coverFor(lead.data.dzielnica, lead.data.image)} alt="" class="aspect-[4/3] w-full border-2 border-navy object-cover" />
        </a>
      </section>
    )}
    <nav class="my-8 flex flex-wrap gap-2">
      {site.dzielnice.map((d) => (
        <a href={`/dzielnice/${dzielnicaSlug(d.name)}/`} class="border border-line px-3 py-1 font-mono text-[10px] uppercase tracking-wider hover:border-navy hover:bg-chalk">{d.name}</a>
      ))}
    </nav>
    <ol class="space-y-0">
      {rest.map((post, i) => (
        <li class="ledger-rule flex gap-4 py-6">
          <span class="font-mono text-sm text-stamp">{String(i + 2).padStart(2, "0")}</span>
          <div class="flex-1">
            <p class="font-mono text-[10px] uppercase text-slate">{post.data.dzielnica} · {post.data.numer}</p>
            <a href={`/akty/${post.slug}/`} class="font-display text-2xl font-semibold hover:text-stamp">{post.data.title}</a>
            <p class="mt-1 text-sm text-slate">{post.data.description}</p>
          </div>
          <img src={coverFor(post.data.dzielnica, post.data.image)} alt="" class="hidden h-16 w-24 border border-line object-cover sm:block" />
        </li>
      ))}
    </ol>
  </main>
</Kronika>
