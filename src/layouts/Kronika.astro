---
import "../styles/global.css";
import site, { dzielnicaSlug } from "../site.config";
const { title, description = site.tagline, image = site.heroImage } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
---
<!doctype html>
<html lang="pl">
  <head>
    <meta charset="UTF-8" />
    <script is:inline>if(location.hostname.indexOf("www.")!==0 && location.hostname.endsWith("akt.waw.pl")){location.replace(location.href.replace("://","://www."));}</script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · {site.name}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={`${title} · ${site.name}`} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta property="og:locale" content="pl_PL" />
    <meta name="robots" content="index,follow" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=Newsreader:ital,opsz,wght@0,6..72,500;0,6..72,700;1,6..72,500&family=Public+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />
  </head>
  <body class="min-h-screen bg-paper font-sans text-navy antialiased">
    <div class="border-b-4 border-navy bg-navy text-paper">
      <div class="mx-auto flex max-w-5xl flex-wrap items-center justify-between gap-2 px-4 py-2 font-mono text-[10px] uppercase tracking-[0.25em]">
        <span>Warszawa · {site.issue}</span>
        <span class="stamp px-2 py-0.5 text-[9px]">AKT</span>
      </div>
    </div>
    <header class="border-b border-line">
      <div class="mx-auto flex max-w-5xl flex-wrap items-end justify-between gap-6 px-4 py-8">
        <a href="/">
          <p class="font-mono text-[10px] uppercase tracking-[0.3em] text-stamp">kronika miejska</p>
          <p class="font-display text-4xl font-bold tracking-tight md:text-5xl">{site.name}</p>
          <p class="mt-2 max-w-md text-sm text-slate">{site.tagline}</p>
        </a>
        <nav class="flex flex-wrap gap-1 font-mono text-[11px] uppercase tracking-wider">
          <a href="/" class="border border-navy/20 px-3 py-1.5 hover:bg-navy hover:text-paper">Start</a>
          <a href="/akty/" class="border border-navy/20 px-3 py-1.5 hover:bg-navy hover:text-paper">Akty</a>
          <a href="/dzielnice/" class="border border-navy/20 px-3 py-1.5 hover:bg-navy hover:text-paper">Dzielnice</a>
          <a href="/redakcja/" class="border border-navy/20 px-3 py-1.5 hover:bg-navy hover:text-paper">Redakcja</a>
          <a href="/kontakt/" class="border border-navy/20 px-3 py-1.5 hover:bg-navy hover:text-paper">Kontakt</a>
        </nav>
      </div>
    </header>
    <slot />
    <footer class="mt-20 border-t-4 border-navy bg-navy text-paper">
      <div class="mx-auto grid max-w-5xl gap-8 px-4 py-12 md:grid-cols-3">
        <div>
          <p class="font-display text-2xl font-bold">{site.name}</p>
          <p class="mt-2 text-sm text-paper/70">{site.address}</p>
        </div>
        <div>
          <p class="font-mono text-[10px] uppercase tracking-widest text-stamp">Dzielnice</p>
          <ul class="mt-3 space-y-1 text-sm">
            {site.dzielnice.map((d) => (
              <li><a class="hover:text-stamp" href={`/dzielnice/${dzielnicaSlug(d.name)}/`}>{d.name}</a></li>
            ))}
          </ul>
        </div>
        <div class="text-sm text-paper/70">
          <p>Nie jesteśmy biuletynem urzędu. Publikujemy teksty o Warszawie tak, jak wygląda z poziomu chodnika i uchwały.</p>
          <p class="mt-4"><a href="/polityka-prywatnosci/" class="underline hover:text-stamp">Prywatność</a> · <a href="/regulamin/" class="underline hover:text-stamp">Regulamin</a></p>
          <p class="mt-2">© {new Date().getFullYear()} {site.name}</p>
        </div>
      </div>
    </footer>
  </body>
</html>
